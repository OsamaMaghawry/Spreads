{
  "name": "TradingAccount",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for the account"
    },
    "api_key": {
      "type": "string",
      "description": "Alpaca API Key ID"
    },
    "api_secret": {
      "type": "string",
      "description": "Alpaca API Secret Key"
    },
    "is_paper": {
      "type": "boolean",
      "default": false,
      "description": "Paper trading account"
    },
    "spreads_client_prefix": {
      "type": "string",
      "description": "Client order id prefix used by the spreads strategy"
    },
    "wheel_client_prefix": {
      "type": "string",
      "description": "Client order id prefix used by the wheel strategy"
    }
  },
  "required": [
    "name",
    "api_key",
    "api_secret"
  ]
}