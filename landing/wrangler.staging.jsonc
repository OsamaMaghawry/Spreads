{
  "name": "deltamint-landing-staging",
  "compatibility_date": "2025-06-05",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // `true` rather than the production config's path list: on staging the
    // Worker must see every request, including static pages and assets, so it
    // can stamp X-Robots-Tag on all of them. Production keeps selective
    // routing, where only blog paths invoke the Worker at all.
    "run_worker_first": true
  },
  "vars": {
    "SITE_URL": "https://dev-landing.deltamint.app",
    // Keeps staging out of every index: a blanket Disallow in robots.txt, an
    // X-Robots-Tag header on every response, and a meta robots tag in the
    // HTML. A dev-landing URL ranking for the brand would compete with the
    // real site for its own terms.
    "NOINDEX": "1",
    // Staging Supabase project — never production's. Same public-by-
    // construction reasoning as landing/wrangler.jsonc.
    "SUPABASE_URL": "https://wpwaomzgpbozzghohwmf.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_kT2Ov5TjG-6MxfU3X-L3HA_BDmlchL1"
  }
}
