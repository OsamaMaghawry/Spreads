VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ALPACA_OAUTH_CLIENT_ID=your-alpaca-oauth-client-id
VITE_ALPACA_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
# Where this build actually lives, for the links Supabase mails out.
# Not VITE_SITE_URL, which is the marketing site. A confirmation email sent
# from a build with no answer for this falls back to the project's Site URL,
# and a stale one there sends new users to an origin where they are not
# signed in and their accounts do not appear.
VITE_APP_URL=http://localhost:5173

