#env
# .env.local holds per-developer values and stays out of the repo. .env.production
# is committed on purpose: it carries only VITE_* values, which Vite inlines into
# the public browser bundle anyway. See the comments in that file.
.env
.env.*
!.env.example
!.env.production

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vite
