{
  "name": "spreads-staging",
  "compatibility_date": "2025-06-05",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/assets/*"
    ]
  },
  "vars": {
    "CANONICAL_HOST": "dev-dash.deltamint.app"
  }
}
