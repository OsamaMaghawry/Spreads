# Build-time configuration for production builds (`vite build`).
#
# Every VITE_* value is inlined into the browser bundle, so all three are public
# by construction — there is nothing here that shipping the bundle doesn't
# already expose. The Supabase key is the *publishable* key, guarded by the RLS
# policies in supabase/migrations/, and an OAuth client ID is public by design
# (it appears in the authorize URL). Real secrets — the Supabase service role key
# and ALPACA_OAUTH_CLIENT_SECRET — are edge function secrets and never belong in
# a VITE_ variable.
#
# Committing these keeps every build environment identical: local, CI, and
# Cloudflare Workers Builds, with no dashboard configuration to keep in sync.
# Variables already present in the build environment take precedence over this
# file, so a platform-level override still wins if you set one later.

VITE_SUPABASE_URL=https://yecfbeohyakuoyczvdbj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_bq8zUxWfrWn6vbyv_NLtsA_62xhUV7U
VITE_ALPACA_OAUTH_CLIENT_ID=fb7e82ef8779c0ad5cbef47b31d8f31d
# Must byte-for-byte match a redirect URI registered on the OAuth app at
# app.alpaca.markets/connect. Explicit rather than derived from the current
# origin: an unregistered URI fails on Alpaca's side as a generic
# "unknown client" page with nothing here to point at.
VITE_ALPACA_OAUTH_REDIRECT_URI=https://dashboard.deltamint.app/oauth/callback

# Public marketing site this environment corresponds to. Used for links from
# the admin blog editor to the published post.
VITE_SITE_URL=https://deltamint.app
