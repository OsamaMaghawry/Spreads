# Build-time configuration for staging builds (`vite build --mode staging`).
#
# Points at the separate "Spread Staging" Supabase project (wpwaomzgpbozzghohwmf),
# not production. Same reasoning as .env.production: every VITE_* value is
# public by construction, so committing it is safe and keeps every build
# environment identical.
#
# Alpaca OAuth reuses the production client ID for now — there is no separate
# staging redirect URI registered with Alpaca yet, so the OAuth connect flow
# will not work against staging until that's set up. Manual API key/secret
# entry works today, since it doesn't depend on the OAuth app at all.

VITE_SUPABASE_URL=https://wpwaomzgpbozzghohwmf.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_kT2Ov5TjG-6MxfU3X-L3HA_BDmlchL1
VITE_ALPACA_OAUTH_CLIENT_ID=fb7e82ef8779c0ad5cbef47b31d8f31d

VITE_SITE_URL=https://dev-landing.deltamint.app
