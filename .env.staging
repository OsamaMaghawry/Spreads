# Build-time configuration for staging builds (`vite build --mode staging`).
#
# Points at the separate "Spread Staging" Supabase project (wpwaomzgpbozzghohwmf),
# not production. Same reasoning as .env.production: every VITE_* value is
# public by construction, so committing it is safe and keeps every build
# environment identical.
#
# Alpaca OAuth currently reuses the production client ID, and the redirect URI
# below must be whitelisted on that same app at app.alpaca.markets/connect.
#
# Whether one app can hold both this and the production redirect URI depends on
# the registration form: Alpaca's spec says "one of the whitelisted redirect
# URIs" (plural), but the form has historically shown a single field. If it only
# takes one, staging needs its own OAuth app and its own client id here —
# these are separate variables precisely so that is a config change, not a code
# change.
#
# Manual API key and secret entry works regardless; it does not use the app.

VITE_SUPABASE_URL=https://wpwaomzgpbozzghohwmf.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_kT2Ov5TjG-6MxfU3X-L3HA_BDmlchL1
VITE_ALPACA_OAUTH_CLIENT_ID=fb7e82ef8779c0ad5cbef47b31d8f31d
# Must byte-for-byte match a redirect URI registered on the OAuth app at
# app.alpaca.markets/connect. Explicit rather than derived from the current
# origin: an unregistered URI fails on Alpaca's side as a generic
# "unknown client" page with nothing here to point at.
VITE_ALPACA_OAUTH_REDIRECT_URI=https://dev-dash.deltamint.app/oauth/callback
# Where this build actually lives, for the links Supabase mails out.
# Not VITE_SITE_URL, which is the marketing site. A confirmation email sent
# from a build with no answer for this falls back to the project's Site URL,
# and a stale one there sends new users to an origin where they are not
# signed in and their accounts do not appear.
VITE_APP_URL=https://dev-dash.deltamint.app


VITE_SITE_URL=https://dev-landing.deltamint.app
